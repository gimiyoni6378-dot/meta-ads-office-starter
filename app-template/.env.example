# Supabase project settings. Never expose the service role key to browser code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DASHBOARD_ALLOWED_EMAILS=owner@example.com

# Meta developer app. Add this exact callback URL in the Meta app after deployment.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-project.vercel.app/api/meta/callback
META_GRAPH_VERSION=v27.0
META_SCOPES=ads_mcp_management,ads_read
META_LOGIN_CONFIG_ID=

# Generate 32 random bytes and encode as 64 hexadecimal characters.
META_TOKEN_ENCRYPTION_KEY=
